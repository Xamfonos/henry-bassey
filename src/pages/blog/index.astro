---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { externalWriting } from '../../data/writing';

/**
 * A gallery of everything Henry has written: posts hosted here first (newest first),
 * then pieces published elsewhere, which open on the outlet's site.
 */
interface Item {
  title: string;
  excerpt: string;
  href: string;
  /** Filter group: the post's category, or the outlet for outside pieces. */
  group: string;
  meta: string;
  cover?: string;
  external?: { outlet: string };
}

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const items: Item[] = [
  ...posts.map((post) => ({
    title: post.data.title,
    excerpt: post.data.excerpt,
    href: `/blog/${post.id}`,
    group: post.data.category,
    meta: `${post.data.category} · ${new Date(post.data.date).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}`,
    cover: post.data.coverImage,
  })),
  ...externalWriting.map((piece) => ({
    title: piece.title,
    excerpt: piece.note,
    href: piece.href,
    group: piece.outlet,
    meta: piece.outlet,
    external: { outlet: piece.outlet },
  })),
];

const groups = [...new Set(items.map((i) => i.group))];
const counts = Object.fromEntries(groups.map((g) => [g, items.filter((i) => i.group === g).length]));

const description = 'Writing on developer marketing, content strategy, SEO, and building in public.';
---

<Layout title="Blog | Henry Bassey" description={description}>
  <div class="page blog-page">
    <div class="wrap">
      <header class="blog-head">
        <p class="page-kicker">Writing</p>
        <h1>Thoughts, breakdowns,<br />and things I figured out.</h1>
        <p class="page-intro">
          Developer marketing, content strategy, technical writing, and the messy middle of operating at a strategic level.
        </p>
      </header>

      <nav class="filters" aria-label="Filter writing">
        <a href="/blog" data-filter="All" aria-current="page">All ({items.length})</a>
        {groups.map((g) => (
          <a href={`/blog?category=${encodeURIComponent(g)}`} data-filter={g}>{g} ({counts[g]})</a>
        ))}
      </nav>

      <p class="empty" data-empty hidden>Nothing in this category yet.</p>

      <ul class="gallery">
        {items.map((item) => (
          <li class="gallery-item reveal" data-category={item.group}>
            <a href={item.href} class="gallery-link">
              <span class:list={['gallery-visual', { 'is-external': item.external }]}>
                {item.cover ? (
                  <img src={item.cover} alt="" width="1200" height="675" loading="lazy" decoding="async" />
                ) : (
                  <span class="gallery-outlet" aria-hidden="true">{item.external?.outlet}</span>
                )}
              </span>
              <span class="gallery-meta">
                {item.meta}
                {item.external && <span class="gallery-away"> · opens on {item.external.outlet} ↗</span>}
              </span>
              <span class="gallery-title">{item.title}</span>
              <span class="gallery-excerpt">{item.excerpt}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <script>
    const items = document.querySelectorAll<HTMLElement>('[data-category]');
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-filter]');
    const empty = document.querySelector<HTMLElement>('[data-empty]');

    function apply(category: string) {
      let shown = 0;
      items.forEach((item) => {
        const match = category === 'All' || item.dataset.category === category;
        item.hidden = !match;
        if (match) shown += 1;
      });
      if (empty) empty.hidden = shown !== 0;
      links.forEach((link) => {
        if (link.dataset.filter === category) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });
    }

    apply(new URLSearchParams(window.location.search).get('category') || 'All');

    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        const category = link.dataset.filter || 'All';
        event.preventDefault();
        const url = new URL(window.location.href);
        if (category === 'All') url.searchParams.delete('category');
        else url.searchParams.set('category', category);
        history.pushState(null, '', url);
        apply(category);
      });
    });
  </script>
</Layout>
