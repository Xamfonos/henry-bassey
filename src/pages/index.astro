---
import Layout from '../layouts/Layout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import PullQuote from '../components/PullQuote.astro';
import TalkMedia from '../components/TalkMedia.astro';
import ConsultingClose from '../components/ConsultingClose.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';
import { externalWriting } from '../data/writing';
import { testimonialGroups } from '../data/testimonials';
import images from '../data/images.json';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

// TODO(henry): swap these names for logos if you have them. LangChain and Fireworks AI were editing work through Growth Plays.
const companies = [
  'Actian',
  'OpenRouter',
  'Databricks',
  'LangChain',
  'Fireworks AI',
  'DoiT',
  'ZenRows',
  'Doppler',
  'Infisical',
];

const chapters = [
  { n: '01', label: 'Make it useful', href: '#useful' },
  { n: '02', label: 'Get it found', href: '#found' },
  { n: '03', label: 'Build the system', href: '#system' },
  { n: '04', label: 'Teach the craft', href: '#craft' },
  { n: '05', label: 'Take it on stage', href: '#speaking' },
  { n: '06', label: 'Ask from home', href: '#africa' },
];

const stages = ['Discover', 'Evaluate', 'Integrate', 'Advocate', 'Compound'];
---

<Layout title={site.title} description={site.description} isHome>
  <div class="wrap">
    <section class="hero" id="about">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1 class="site-title">{site.h1}</h1>
          <p class="hook">{site.hook}</p>
          <div class="intro-copy">
            <p>
              I’m Henry. I lead developer marketing at Hackmamba. My work for Actian VectorAI DB has reached over 5 million developers.
            </p>
            <p>
              I started as a developer, moved into marketing, and found that the best work happens between the two.
              Along the way, I earned an MBA from Quantic (full scholarship, thank you). Each chapter below is one piece of my work.
            </p>
            <div class="actions">
              <a href="/work">See full portfolio</a>
              <a href="#contact">Reach out</a>
            </div>
          </div>
        </div>
        <figure class="hero-photo">
          <ResponsiveImage
            image={images.hero}
            alt="Henry Bassey, developer marketing and AI automation consultant"
            sizes="(max-width: 800px) 300px, (max-width: 980px) 34vw, 420px"
            priority
          />
        </figure>
      </div>
      <p class="byline">
        <span class="byline-lead">I’ve worked with teams at</span>
        {companies.map((name, i) => (
          <>
            <span class="byline-name">{name}</span>
            {i < companies.length - 1 && <span class="byline-sep" aria-hidden="true"> · </span>}
          </>
        ))}
      </p>
    </section>

    <nav class="journey-index" aria-label="Chapters">
      {chapters.map((c) => (
        <a href={c.href}><b>{c.n}</b> {c.label}</a>
      ))}
    </nav>

    <div class="story">
      <section class="chapter" id="useful" aria-labelledby="ch1-title">
        <header>
          <div class="chapter-n" aria-hidden="true">01</div>
          <p class="chapter-label reveal">Make something useful</p>
          <h2 class="reveal" id="ch1-title">What if the marketing was a tool?</h2>
          <p class="chapter-subtitle reveal">Leading developer marketing for Actian VectorAI DB</p>
        </header>
        <div class="chapter-body reveal">
          <div class="prose">
            <p class="tension">
              I joined the Actian VectorAI DB launch as content lead. After launch, the work started moving in silos.
            </p>
            <p>
              I was promoted to developer marketing lead on the account and brought content, paid media and community under one plan. Part of that plan was building free tools developers could use without talking to sales. When our messaging moved on, I also rewrote and rebuilt the product landing page so the website and social said the same thing.
            </p>
          </div>
          <aside class="evidence-col" aria-label="Chapter 01 in numbers">
            <div class="evidence">
              <div class="big-stat">~5M</div>
              <p>developers reached across the Actian launch so far</p>
              <small>Starting from 300K+ on launch day.</small>
            </div>
            <p class="annotation">
              “Hackmamba didn’t just execute a plan. They helped us build the right plan.” Jennifer Jackson, CMO, Actian.
            </p>
          </aside>
        </div>
        <figure class="figure reveal">
          <ResponsiveImage
            image={images.calculator}
            alt="The Actian VectorAI DB sizing calculator. For a workload of 100,000 vectors, its verdict reads: You don't need a vector database yet."
            sizes="(max-width: 800px) 100vw, 960px"
          />
          <figcaption>The sizing calculator. Sometimes it tells you to skip the vector database.</figcaption>
        </figure>
        <!-- One image per chapter on the homepage. Agent Memory Hub, awesome-selfhosted-ai, the rebuilt landing page (images.landingPage) and the on-prem SERP (images.serpOnPrem) are reserved for /work#actian and /work#content-search. -->
        <p class="chapter-link reveal"><a href="/work#actian">Read the Actian story</a></p>
      </section>

      <PullQuote
        quote="Lindsay, Ron and Nick love the website."
        name="Gergely Mate"
        role="Project Manager · Hackmamba"
      />

      <section class="chapter" id="found" aria-labelledby="ch2-title">
        <header>
          <div class="chapter-n" aria-hidden="true">02</div>
          <p class="chapter-label reveal">Run the full funnel</p>
          <h2 class="reveal" id="ch2-title">A useful tool still has to be found.</h2>
          <p class="chapter-subtitle reveal">Paid and organic growth for developer tools</p>
        </header>
        <div class="chapter-body has-spotlight reveal">
          <div class="prose">
            <p class="tension">
              For Actian, I ran paid media with Tahir Mohammed, from X ads and newsletter sponsorships to influencer partnerships.
            </p>
            <p>
              On the organic side, an Actian article on vector database pricing reached Google’s first page and AI Overviews within seven days. I also led content for OpenRouter, whose blog passed 110,000 organic clicks in 126 days.
            </p>
          </div>
          <aside class="evidence-col" aria-label="Chapter 02 in numbers">
            <div class="evidence">
              <div class="big-stat">5,000+</div>
              <p>newsletter clicks from sponsorships</p>
              <small>Across more than a dozen publications, including AlphaSignal, DataTalks.Club and Real Python.</small>
            </div>
            <p class="annotation">
              “The last Actian campaign performed really well … far exceeding our 500-click benchmark!” Jana Marinovic, Account Manager, AlphaSignal.
            </p>
          </aside>
          <!-- The Actian campaign results (X ads, influencers) live on /work#paid-media. Henry did not own the LinkedIn campaign (Tahir did), so it is not credited to him anywhere. -->
          <div class="prose spotlight" aria-labelledby="spotlight-zenrows">
            <p class="spotlight-label">Client spotlight</p>
            <h3 id="spotlight-zenrows">ZenRows</h3>
            <p class="spotlight-role">Content strategy, technical SEO and AI-assisted research</p>
            <p>
              I’m helping reposition ZenRows as web data infrastructure for AI. The work started with finding out why traffic had dropped. I led the content work across competitor comparisons and practical agent tutorials, and researched how ZenRows appeared in AI-generated answers.
            </p>
            <dl class="spotlight-stats">
              <div>
                <dt>7,000+</dt>
                <dd>blog search clicks, up more than 50%</dd>
              </div>
              <div>
                <dt>30%+</dt>
                <dd>of the AI answers in our tracked prompt set included ZenRows</dd>
              </div>
            </dl>
            <p class="spotlight-note">October 2026, compared with the four weeks before.</p>
            <p class="spotlight-link"><a href="/work#zenrows">Read the ZenRows story</a></p>
          </div>
        </div>
        <!-- The pricing and on-prem SERP screenshots (images.serpPricing, images.serpOnPrem) move to /work#content-search. -->
        <p class="chapter-link reveal"><a href="/work#paid-media">See the paid and organic work</a></p>
      </section>

      <section class="chapter" id="system" aria-labelledby="ch3-title">
        <header>
          <div class="chapter-n" aria-hidden="true">03</div>
          <p class="chapter-label reveal">Give the work a system</p>
          <h2 class="reveal" id="ch3-title">The fix wasn’t another piece of content.</h2>
          <p class="chapter-subtitle reveal">Developer Adoption Architecture</p>
        </header>
        <div class="chapter-body reveal">
          <div class="prose">
            <p class="tension">
              Hackmamba was known for technical content, but the work had grown into launches, communities, paid media and events.
            </p>
            <p>
              Across our client work, one stage of the developer journey kept being left to chance. So I built the Developer Adoption Architecture and led Hackmamba’s rebrand into a full-cycle developer growth agency.
            </p>
          </div>
          <aside class="evidence-col" aria-label="Chapter 03 in numbers">
            <div class="evidence compact">
              <div class="big-stat">29.04.26</div>
              <p>The day the rebrand went public.</p>
            </div>
          </aside>
        </div>
        <figure class="diagram reveal">
          <figcaption class="diagram-label">Developer Adoption Architecture</figcaption>
          <ol class="stages">
            {stages.map((stage, i) => (
              <li>
                {stage}
                {i < stages.length - 1 && <span class="stage-arrow" aria-hidden="true">→</span>}
              </li>
            ))}
          </ol>
        </figure>
        <figure class="figure reveal">
          <ResponsiveImage
            image={images.rebrand}
            alt="Hackmamba article, Hackmamba is now a full-cycle developer growth agency, by Henry Bassey, 29 April 2026."
            sizes="(max-width: 800px) 100vw, 960px"
          />
          <figcaption>The rebrand announcement I wrote for Hackmamba.</figcaption>
        </figure>
        <p class="chapter-link reveal">
          <a href="/work#developer-adoption-architecture">How the Developer Adoption Architecture works</a>
        </p>
      </section>

      <section class="chapter" id="craft" aria-labelledby="ch4-title">
        <header>
          <div class="chapter-n" aria-hidden="true">04</div>
          <p class="chapter-label reveal">Teach the system to write</p>
          <h2 class="reveal" id="ch4-title">Good writing shouldn’t depend on luck.</h2>
          <p class="chapter-subtitle reveal">A technical writing skill for people and AI agents</p>
        </header>
        <div class="chapter-body reveal">
          <div class="prose">
            <p class="tension">
              I’ve edited hundreds of technical articles. The good ones have a clear point, a logical flow and code that backs up every claim.
            </p>
            <p>
              So I wrote down what makes them work and turned it into an open-source skill for writers and AI agents. It later fed into Boki, Hackmamba’s content system.
            </p>
          </div>
          <aside class="evidence-col" aria-label="Chapter 04 in numbers">
            <div class="evidence">
              <div class="big-stat">26</div>
              <p>writing principles across 5 areas</p>
              <small>Open source under the MIT licence.</small>
            </div>
          </aside>
        </div>
        <figure class="figure reveal">
          <ResponsiveImage
            image={images.writingSkill}
            alt="The Xamfonos/technical-writing-best-practices repository on GitHub: a Claude Code skill for technical content, with 26 principles across 5 domains and an MIT licence."
            sizes="(max-width: 800px) 100vw, 960px"
          />
          <figcaption>The technical writing skill on GitHub.</figcaption>
        </figure>
        <p class="chapter-link reveal"><a href="/work#writing-skill">See the writing skill</a></p>
      </section>

      <PullQuote
        quote="Great edits here. I think this is one of the best pieces of content we’ve drafted as a company."
        name="John-Henry Scherck"
        role="Founder & CEO, Growth Plays"
      />

      <section class="chapter" id="speaking" aria-labelledby="ch5-title">
        <header>
          <div class="chapter-n" aria-hidden="true">05</div>
          <p class="chapter-label reveal">Take it on stage</p>
          <h2 class="reveal" id="ch5-title">I test these ideas on stage, too.</h2>
          <p class="chapter-subtitle reveal">Talks and panels on developer marketing</p>
        </header>
        <div class="chapter-body is-single reveal">
          <div class="prose">
            <p class="tension">A framework only proves itself when you explain it to real people.</p>
            <p>
              I’ve spoken at The Builders Summit in Lagos and AI Summit in Uyo, and joined conversations on Reo.Dev’s DevGTM series and the DevRel Compass panel.
            </p>
          </div>
        </div>
        <TalkMedia caption="The Builders Summit, Lagos, April 2026" class="reveal" />
        <p class="chapter-link reveal"><a href="/work#speaking">All talks</a></p>
      </section>

      <PullQuote
        quote="Developer Marketing is company-first. DevRel is developer-first. But at the end of the day, we need to work together."
        name="DevRel Compass panel, March 2026"
      />

      <section class="chapter" id="africa" aria-labelledby="ch6-title">
        <header>
          <div class="chapter-n" aria-hidden="true">06</div>
          <p class="chapter-label reveal">Ask a question closer to home</p>
          <h2 class="reveal" id="ch6-title">I do this from Lagos.<br />What does that change?</h2>
          <p class="chapter-subtitle reveal">Developer marketing in Africa and the diaspora</p>
        </header>
        <div class="chapter-body reveal">
          <div class="prose">
            <p class="tension">Does developer marketing work the same way in Africa? And for which tools?</p>
            <p>
              I work from Lagos, mostly for companies based elsewhere, so this question is hard to ignore. I’m turning it into open research for builders and investors.
            </p>
          </div>
          <aside class="evidence-col" aria-label="Chapter 06 in numbers">
            <div class="evidence">
              <div class="big-stat">30.2%</div>
              <p>of African developers have a say in tool purchases</p>
              <small>Compared with 21.7% globally. Stack Overflow 2024, small sample.</small>
            </div>
          </aside>
        </div>
        <figure class="figure figure-narrow reveal">
          <ResponsiveImage
            image={images.speakerCard}
            alt="Geek Circle speaker card for The Builders Summit, naming Henry Bassey as Developer Marketer and Head of Technical Content at Hackmamba, at the Ananse Center for Design in Lekki."
            sizes="(max-width: 800px) 100vw, 560px"
          />
          <figcaption>The speaker card for my Lagos talk, as printed by Geek Circle.</figcaption>
        </figure>
        <p class="chapter-link reveal"><a href="/work#africa">Read the early findings</a></p>
      </section>
    </div>

    <section class="next reveal" id="openstrategy" aria-labelledby="openstrategy-title">
      <p class="next-label">Work in progress</p>
      <h2 id="openstrategy-title">How can humans and AI agents make better strategy decisions in this AI era?</h2>
      <p>
        I’m turning business strategy frameworks into tools humans and AI agents can use to make better decisions. It’s called OpenStrategy (formerly Marketing Console), and it’s still being built.
      </p>
    </section>

    <section class="love is-open" id="wall-of-love" aria-labelledby="love-title">
      <h2 id="love-title">Wall of love</h2>
      <p class="love-intro">Kind words from clients, teammates and readers.</p>
      <div class="love-groups" id="love-groups">
        {testimonialGroups.map((group) => (
          <div class="love-group reveal" aria-labelledby={`love-${group.id}`}>
            <h3 class="love-group-title" id={`love-${group.id}`}>{group.title}</h3>
            {group.chat ? (
              <ul class="love-chat">
                {group.items.map((line) => (
                  <li>
                    <span class="love-chat-name">{line.name}:</span> “{line.quote}”
                  </li>
                ))}
              </ul>
            ) : (
              <ul class="love-list">
                {group.items.map((item, i) => (
                  <li class:list={['love-item', { 'love-extra': i > 0 }]}>
                    <blockquote>
                      <p>{item.quote}</p>
                    </blockquote>
                    <p class="love-by">
                      {item.name}
                      {item.role && <span>{item.role}</span>}
                    </p>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
      <button class="love-more" type="button" aria-controls="love-groups" aria-expanded="false" hidden>
        Show more
      </button>
    </section>

    <section class="callout reveal" aria-labelledby="callout-title">
      <h2 id="callout-title">There’s more where this came from.</h2>
      <p>The portfolio has the full stories, the tools and the numbers behind them.</p>
      <p class="callout-action"><a href="/work">See the portfolio</a></p>
    </section>

    <section class="writing-block reveal" id="writing" aria-labelledby="writing-title">
      <h2 id="writing-title">Selected writing</h2>
      <p class="writing-intro">A few favourites. The rest are <a href="/blog">on the blog</a>.</p>
      <ul class="writing-list">
        {externalWriting.map((piece) => (
          <li>
            <a href={piece.href}>
              <span class="writing-outlet">{piece.outlet}</span>
              <span class="writing-title">{piece.title}</span>
              <span class="writing-note">{piece.note}</span>
            </a>
          </li>
        ))}
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>
              <span class="writing-outlet">
                Blog · {new Date(post.data.date).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}
              </span>
              <span class="writing-title">{post.data.title}</span>
              <span class="writing-note">{post.data.excerpt}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <ConsultingClose />

  <script>
    // Wall of love: on small screens, show one quote per group until "Show more" is pressed.
    const love = document.querySelector<HTMLElement>('.love');
    const more = document.querySelector<HTMLButtonElement>('.love-more');
    if (love && more) {
      love.classList.remove('is-open');
      more.hidden = false;
      more.addEventListener('click', () => {
        love.classList.add('is-open');
        more.setAttribute('aria-expanded', 'true');
        more.hidden = true;
        love.querySelector<HTMLElement>('.love-extra')?.setAttribute('tabindex', '-1');
        love.querySelector<HTMLElement>('.love-extra')?.focus();
      });
    }
  </script>
</Layout>
