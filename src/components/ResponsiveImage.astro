---
interface Source {
  w: number;
  h: number;
}

interface ImageAsset {
  src: string;
  width: number;
  height: number;
  sources: Source[];
}

interface Props {
  image: ImageAsset;
  alt: string;
  sizes: string;
  priority?: boolean;
  class?: string;
}

const { image, alt, sizes, priority = false, class: className } = Astro.props;
const avif = image.sources.map((s) => `${image.src}-${s.w}.avif ${s.w}w`).join(', ');
const webp = image.sources.map((s) => `${image.src}-${s.w}.webp ${s.w}w`).join(', ');
const fallback = `${image.src}-${image.sources[image.sources.length - 1].w}.webp`;
---

<picture>
  <source type="image/avif" srcset={avif} sizes={sizes} />
  <source type="image/webp" srcset={webp} sizes={sizes} />
  <img
    src={fallback}
    alt={alt}
    width={image.width}
    height={image.height}
    sizes={sizes}
    class={className}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : 'auto'}
  />
</picture>
